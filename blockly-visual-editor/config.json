{
  "name": "Blockly Visual Editor",
  "version": "0.6.0",
  "slug": "blockly-visual-editor",
  "description": "Ein visueller Editor für Blockly-basierte Automatisierungen in Home Assistant",
  "url": "https://github.com/ferdifighter/hassio-blockly-visual-editor",
  "changelog": "https://github.com/ferdifighter/hassio-blockly-visual-editor/blob/main/blockly-visual-editor/CHANGELOG.md",
  "author": "FerdiFighter",
  "arch": [
    "armhf",
    "armv7",
    "aarch64",
    "amd64",
    "i386"
  ],
  "startup": "services",
  "init": false,
  "ports": {
    "8099/tcp": null
  },
  "map": [
    "data:rw",
    "config:rw",
    "ssl:rw"
  ],
  "options": {
    "log_level": "info",
    "theme": "auto",
    "language": "system"
  },
  "schema": {
    "log_level": "list(debug|info|notice|warning|error|fatal)?",
    "theme": "list(auto|light|dark)?",
    "language": "list(system|de|en)?",
    "hass_api_url": "str?",
    "hass_token": "str?",
    "ha_url": "str?",
    "ha_token": "str?"
  },
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:puzzle",
  "panel_title": "Blockly Editor",
  "homeassistant_api": true,
  "auth_api": true,
  "ingress_stream": true,
  "hassio_role": "admin",
  "hassio_api": true
} 