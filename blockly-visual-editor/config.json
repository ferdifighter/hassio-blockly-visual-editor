{
  "name": "Blockly Visual Editor",
  "version": "1.0.0",
  "slug": "blockly-visual-editor",
  "description": "Ein visueller Editor für Blockly-basierte Automatisierungen in Home Assistant",
  "arch": [
    "armhf",
    "armv7",
    "aarch64",
    "amd64",
    "i386"
  ],
  "startup": "application",
  "init": false,
  "ports": {
    "3000/tcp": 3000
  },
  "map": [
    "config:rw",
    "ssl:rw"
  ],
  "options": {
    "log_level": "info"
  },
  "schema": {
    "log_level": "list(debug|info|notice|warning|error|fatal)?",
    "hass_api_url": "str?",
    "hass_token": "str?"
  }
} 